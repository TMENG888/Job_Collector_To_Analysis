# Source-only working tree. Runtime data stays in its existing location.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/package-lock.json
!/requirements.txt
!/启动岗位采集控制台.bat
!/desktop/
!/docs/
!/job_collector_ui/
!/licenses/
!/scripts/
!/work/

# work/ contains source alongside huge data, environments and one-off probes.
/work/*
!/work/*.mjs
!/work/*.py
!/work/personal-wiki-ocr.ps1
!/work/requirements*.txt
!/work/COLLECTOR_DEPENDENCIES.md
!/work/job51/
!/work/models/
/work/models/*
!/work/models/role-screening/
/work/models/role-screening/*
# Only the five already-published immutable models, never training corpora.
!/work/models/role-screening/data-analysis-tfidf-lr-v1.json
!/work/models/role-screening/agent-app-tfidf-lr-v1.json
!/work/models/role-screening/embedded-tfidf-lr-v1.json
!/work/models/role-screening/software-testing-tfidf-lr-v1.json
!/work/models/role-screening/multirole-registry-v1.json
/work/_*
/work/probe_*
/work/audit_*
!/work/audit_job_admission.mjs
/work/evaluate_*
/work/report_*
/work/review_*
/work/verify_*
/work/compare_*
/work/diagnose_*
/work/diff_*
/work/find_*
/work/finish_*
/work/fix_*
/work/gen_*
/work/read_*
/work/rebuild_*
/work/reconcile_*
/work/reset_*
/work/render_*
/work/run_*
/work/seal_*
